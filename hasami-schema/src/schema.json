{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odd/hasami/schema/command-v1.json",
  "title": "hasami command definition",
  "description": "Everything a hasami parser accepts for one command, including hidden arguments and subcommands. Produced by hasami_schema::to_json.",
  "$ref": "#/$defs/command",
  "$defs": {
    "command": {
      "type": "object",
      "required": ["name", "version", "about", "long_about", "after_help", "help_flag", "version_flag", "subcommand_required", "args", "groups", "requires", "subcommands"],
      "properties": {
        "format": { "type": "integer", "const": 1, "description": "Document format version; present on the root command only." },
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "about": { "type": ["string", "null"] },
        "long_about": { "type": ["string", "null"] },
        "after_help": { "type": ["string", "null"] },
        "help_flag": { "type": "boolean", "description": "Whether -h/--help is accepted." },
        "version_flag": { "type": "boolean", "description": "Whether -V/--version is accepted." },
        "subcommand_required": { "type": "boolean" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/arg" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "requires": {
          "type": "array",
          "description": "Pairs [a, b]: if argument id a is present, b must be present.",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
        },
        "subcommands": { "type": "array", "items": { "$ref": "#/$defs/subcommand" } }
      }
    },
    "arg": {
      "type": "object",
      "required": ["id", "long", "short", "aliases", "short_aliases", "positional", "takes_value", "value_name", "value_optional", "required", "many", "count", "hidden", "global", "help", "default", "default_missing", "possible_values", "env", "dynamic_completion"],
      "properties": {
        "id": { "type": "string" },
        "long": { "type": ["string", "null"], "description": "Long name without dashes." },
        "short": { "type": ["string", "null"], "description": "Short name, one character." },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "short_aliases": { "type": "array", "items": { "type": "string" } },
        "positional": { "type": "boolean" },
        "takes_value": { "type": "boolean" },
        "value_name": { "type": ["string", "null"] },
        "value_optional": { "type": "boolean", "description": "The value may be omitted (--opt[=VALUE])." },
        "required": { "type": "boolean" },
        "many": { "type": "boolean", "description": "May repeat, collecting every value." },
        "count": { "type": "boolean", "description": "A counting flag (-vvv)." },
        "hidden": { "type": "boolean" },
        "global": { "type": "boolean", "description": "Accepted by every subcommand below the defining command." },
        "help": { "type": ["string", "null"] },
        "default": { "type": ["string", "null"], "description": "Default value as shown in help." },
        "default_missing": { "type": ["string", "null"], "description": "Value used when the option is given without one." },
        "possible_values": { "type": "array", "items": { "type": "string" } },
        "env": { "type": ["string", "null"] },
        "dynamic_completion": { "type": "boolean", "description": "A runtime completion function is attached." }
      }
    },
    "group": {
      "type": "object",
      "required": ["name", "members", "required", "exclusive"],
      "properties": {
        "name": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "exclusive": { "type": "boolean" }
      }
    },
    "subcommand": {
      "type": "object",
      "required": ["name", "aliases", "hidden", "about", "command"],
      "properties": {
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "hidden": { "type": "boolean" },
        "about": { "type": ["string", "null"] },
        "command": { "$ref": "#/$defs/command" }
      }
    }
  }
}
